          ]
        },
        {
          "id": "d7_8",
          "speaker": "lili",
          "zh": "对了，你有兄弟姐妹吗？",
          "pinyin": "Duì le, nǐ yǒu xiōngdì jiěmèi ma?",
          "ja": "そういえば、兄弟や姉妹はいるの？",
          "segments": [
            "对了，",
            "你有兄弟姐妹吗？"
          ],
          "notes": [
            {
              "word": "对了",
              "pinyin": "duì le",
              "meaning": "そういえば、ところで"
            },
            {
              "word": "兄弟姐妹",
              "pinyin": "xiōngdì jiěmèi",
              "meaning": "兄弟姉妹"
            }
          ]
        },
        {
          "id": "d7_9",
          "speaker": "jieming",
          "zh": "我有一个姐姐和两个哥哥。你呢？",
          "pinyin": "Wǒ yǒu yí gè jiějie hé liǎng gè gēge. Nǐ ne?",
          "ja": "姉が1人と兄が2人いるよ。君は？",
          "segments": [
