      "lines": [
        {
          "id": "d7_1",
          "speaker": "jieming",
          "zh": "李丽，最近怎么样？",
          "pinyin": "Lìli, zuìjìn zěnmeyàng?",
          "ja": "リーリー、最近どう？",
          "segments": [
            "李丽，",
            "最近怎么样？"
          ],
          "notes": [
            {
              "word": "最近",
              "pinyin": "zuìjìn",
              "meaning": "最近（HSK2）"
            },
            {
              "word": "怎么样",
              "pinyin": "zěnmeyàng",
              "meaning": "どうですか、いかがですか（HSK1）"
            }
          ]
        },
        {
          "id": "d7_2",
          "speaker": "lili",
          "zh": "还不错！你呢？",
          "pinyin": "Hái búcuò! Nǐ ne?",
          "ja": "まあまあ順調よ！あなたは？",
          "segments": [
            "还不错！",
            "你呢？"
          ],
          "notes": [
            {
              "word": "还不错",
              "pinyin": "hái búcuò",
              "meaning": "悪くない、まあまあ良い（HSK2）"
            }
          ]
        },
        {
          "id": "d7_3",
          "speaker": "jieming",
          "zh": "非常好，也非常开心！因为我妈妈会来看我。",
          "pinyin": "Fēicháng hǎo, yě fēicháng kāixīn! Yīnwèi wǒ māma huì lái kàn wǒ.",
          "ja": "すごくいいよ、とても嬉しいんだ！母が僕に会いに来てくれるからね。",
          "segments": [
            "非常好，",
            "也非常开心！",
            "因为我妈妈会来看我。"
          ],
          "notes": [
            {
              "word": "开心",
              "pinyin": "kāixīn",
              "meaning": "楽しい、嬉しい（HSK3）"
            },
            {
              "word": "因为",
              "pinyin": "yīnwèi",
              "meaning": "なぜなら〜だから（接続詞, HSK2）"
            },
            {
              "word": "会",
              "pinyin": "huì",
              "meaning": "〜する予定だ、〜するだろう（可能性・予測）"
            },
            {
              "word": "看",
              "pinyin": "kàn",
              "meaning": "訪ねる、会いに行く（看朋友/看妈妈）"
            }
          ]
        },
        {
          "id": "d7_4",
          "speaker": "lili",
          "zh": "太好了！她什么时候到？",
          "pinyin": "Tài hǎo le! Tā shénme shíhou dào?",
          "ja": "よかったじゃない！お母さんはいつ到着するの？",
          "segments": [
            "太好了！",
            "她什么时候到？"
          ],
          "notes": [
            {
              "word": "太好了",
              "pinyin": "tài hǎo le",
              "meaning": "よかった、素晴らしい"
            },
            {
              "word": "什么时候",
              "pinyin": "shénme shíhou",
              "meaning": "いつ（HSK1）"
            },
            {
              "word": "到",
              "pinyin": "dào",
              "meaning": "着く、到着する（HSK2）"
            }
          ]
        },
        {
          "id": "d7_5",
          "speaker": "jieming",
          "zh": "她下星期五早上到，我和苏飞会去飞机场接她。",
          "pinyin": "Tā xià xīngqīwǔ zǎoshang dào, wǒ hé Sūfēi huì qù fēijīchǎng jiē tā.",
          "ja": "来週の金曜日の朝に着くよ。僕とスーフェイで空港まで迎えに行くんだ。",
          "segments": [
            "她下星期五早上到，",
            "我和苏飞会去飞机场接她。"
          ],
          "notes": [
            {
              "word": "下星期五",
              "pinyin": "xià xīngqīwǔ",
              "meaning": "来週の金曜日"
            },
            {
